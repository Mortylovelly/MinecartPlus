{
  "schemaVersion": 1,
  "id": "minecartmagic",
  "version": "${version}",
  "name": "Minecart Magic",
  "description": "Adds the Traction enchantment for minecarts, Tailwind for boats, and self-propelling vehicles.",
  "authors": [
    "Mortylovelly"
  ],
  "contact": {
    "sources": "https://github.com/Mortylovelly/MinecartPlus"
  },
  "license": "MIT",
  "icon": "assets/minecartmagic/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.minecartmagic.MinecartMagicMod"
    ],
    "client": [
      "com.minecartmagic.client.MinecartMagicClient"
    ]
  },
  "mixins": [
    "minecartmagic.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.17.2",
    "minecraft": "~1.20.1",
    "java": ">=17",
    "fabric-api": ">=0.92.11+1.20.1",
    "geckolib": ">=4.8.4"
  }
}
